+// 如果超过这个时间没有收到任何消息，则认为连接已死。
+// 可通过 KOMARI_AGENT_READ_WAIT 设置，例如 "60s"；纯数字按秒处理。
+var readWait = getReadWaitDuration()
+
+func getReadWaitDuration() time.Duration {
+	value := os.Getenv("KOMARI_AGENT_READ_WAIT")
+	if value == "" {
+		return 11 * time.Second
+	}
+
+	if seconds, err := strconv.Atoi(value); err == nil {
+		if seconds > 0 {
+			return time.Duration(seconds) * time.Second
+		}
+		return 11 * time.Second
+	}
+
+	duration, err := time.ParseDuration(value)
+	if err != nil || duration <= 0 {
+		return 11 * time.Second
+	}
+
+	return duration
+}


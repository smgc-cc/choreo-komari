# Caddy configuration for Choreo deployment
# 将 8081 端口的所有请求代理到 Komari 的 8080 端口

:8081 {
    # 处理管理员终端请求
    # 请求格式: /api/clients/terminal?browser=true&target={uuid}
    # 需要重写为: /api/admin/client/{uuid}/terminal
    @browser_terminal {
        path /api/clients/terminal
        query browser=true
    }
    route @browser_terminal {
        # 使用 uri 指令进行路径替换
        # 从查询参数中提取 target 值需要使用 header_regexp 或其他方式
        # 简化方案：直接让 Caddy 传递原始请求头中的信息

        # 由于 Caddy 不能直接在 rewrite 中使用查询参数
        # 我们需要通过设置请求头来传递 target UUID
        header_up X-Target-UUID {query.target}
        reverse_proxy localhost:8080 {
            # 后端需要从 X-Target-UUID 头或查询参数读取目标
        }
    }

    # 其他所有请求直接代理
    handle {
        reverse_proxy localhost:8080
    }
}

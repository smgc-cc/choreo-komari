# Dockerfile for Choreo deployment
# 使用多阶段构建，从源码编译

# ============ 构建阶段 ============
FROM golang:1.24-alpine AS builder

WORKDIR /build

# 安装构建依赖
RUN apk add --no-cache git gcc musl-dev

# 复制 go.mod 和 go.sum 先下载依赖（利用缓存）
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 构建二进制文件
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o komari .

# ============ 运行阶段 ============
FROM alpine:3.21

WORKDIR /app

# 安装运行时依赖
RUN apk add --no-cache \
    aws-cli \
    tar \
    gzip \
    sqlite \
    tzdata \
    ca-certificates \
    && rm -rf /var/cache/apk/*

# Choreo 要求：创建非 root 用户，UID 必须在 10000-20000 范围内
RUN adduser -D -u 10001 -g komari komari

# 从构建阶段复制二进制文件
COPY --from=builder /build/komari /app/komari
COPY --from=builder /build/public/dist /app/public/dist
COPY --from=ghcr.io/komari-monitor/komari-agent:latest /app/komari-agent /app/komari-agent

# 设置权限
RUN chmod +x /app/komari && \
    mkdir -p /app/data && \
    chown -R komari:komari /app

# 复制并授权脚本
COPY backup.sh /app/backup.sh
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/*.sh

# 切换到非 root 用户
USER 10001

# 环境变量配置
ENV GIN_MODE=release
ENV KOMARI_DB_TYPE=sqlite
ENV KOMARI_DB_FILE=/app/data/komari.db
ENV KOMARI_LISTEN=0.0.0.0:8080
ENV KOMARI_WS_LISTEN=0.0.0.0:8081

# 暴露端口：HTTP (8080) 和 WebSocket (8081)
EXPOSE 8080 8081

# 启动命令
CMD ["/app/entrypoint.sh"]

# Caddy :8081 (Choreo WS) → Komari :8080
#
# 浏览器终端（Snippet 注入）:
#   wss://komari.chatsfun.nyc.mn/default/komari/komari_ws/v1.0/api/clients/admin-terminal/{uuid}?session_token=...
#
# 网关可能保留前缀或已剥前缀，两种都要认。
# session_token query → Cookie（Komari 只认 Cookie，不认 query）

:8081 {
	# 1) 剥掉 Choreo WS 网关前缀（若仍在 path 上）
	@ws_prefixed path_regexp ws_pref ^/default/komari/komari_ws/v1\.0(/.*)$
	rewrite @ws_prefixed {re.ws_pref.1}

	# 2) 终端捷径 + session_token → Cookie + rewrite 到官方终端路径
	@term_sess {
		path_regexp ts ^/api/clients/admin-terminal/([^/]+)/?$
		query session_token=*
	}
	handle @term_sess {
		rewrite * /api/admin/client/{re.ts.1}/terminal
		reverse_proxy localhost:8080 {
			# header_up 比 request_header 更常见、兼容性更好
			header_up Cookie "session_token={query.session_token}"
			header_up -Origin
		}
	}

	# 3) 终端捷径（无 query，已有 Cookie 时）
	@term_plain path_regexp tp ^/api/clients/admin-terminal/([^/]+)/?$
	handle @term_plain {
		rewrite * /api/admin/client/{re.tp.1}/terminal
		reverse_proxy localhost:8080 {
			header_up -Origin
		}
	}

	# 4) 标准终端路径 + session query（兼容）
	@admin_sess {
		path_regexp as ^/api/admin/client/([^/]+)/terminal/?$
		query session_token=*
	}
	handle @admin_sess {
		reverse_proxy localhost:8080 {
			header_up Cookie "session_token={query.session_token}"
			header_up -Origin
		}
	}

	# 5) 公开 WS 等
	handle {
		reverse_proxy localhost:8080 {
			header_up -Origin
		}
	}
}

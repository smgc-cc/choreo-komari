# Caddy :8081 (Choreo WS) → Komari :8080
#
# - admin-terminal 路径 rewrite（绕过网关对 /api/admin 限制）
# - ?session_token= → Cookie（sfun 页面跨到 chatsfun WS 时用，无 Cloudflare Worker）

:8081 {
	# 1) 终端捷径路径
	@admin_terminal path_regexp admin_terminal ^/api/clients/admin-terminal/([^/]+)/?$
	rewrite @admin_terminal /api/admin/client/{re.admin_terminal.1}/terminal

	# 2) query session_token 写成 Cookie（覆盖 Cookie 头；终端只依赖 session）
	@has_session query session_token=*
	request_header @has_session Cookie "session_token={query.session_token}"

	# 3) 全部反代到 Komari（含已 rewrite 的终端与普通 /api/rpc2）
	reverse_proxy localhost:8080
}

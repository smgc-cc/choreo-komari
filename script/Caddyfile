# Caddy configuration for Choreo deployment
# 将 8081 端口的所有请求代理到 Komari 的 8080 端口

:8081 {
    # 将 /api/clients/admin-terminal/{uuid} 重写回 /api/admin/client/{uuid}/terminal
    # 这是为了绕过 Choreo WS 端点只允许 /api/clients/* 路径的限制
    @admin_terminal path_regexp admin_terminal ^/api/clients/admin-terminal/(.+)$
    handle @admin_terminal {
        rewrite @admin_terminal /api/admin/client/{re.admin_terminal.1}/terminal
        reverse_proxy localhost:8080
    }

    # 其他所有请求直接代理
    handle {
        reverse_proxy localhost:8080
    }
}
